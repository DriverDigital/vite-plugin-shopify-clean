{
  "name": "@driver-digital/vite-plugin-shopify-clean",
  "version": "2.0.2",
  "type": "module",
  "description": "Vite plugin for correctly cleaning up an assets folder",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vite",
    "shopify",
    "vite-plugin"
  ],
  "author": "Driver Digital",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tsup src/index.ts --dts --format cjs,esm --target node22 --clean",
    "watch": "tsup src/index.ts --dts --format cjs,esm --target node22 --clean --watch",
    "lint": "eslint src --ext .ts,.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-package": "node scripts/verify-package.mjs",
    "test:sandbox": "bash scripts/test-integration.sh"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.18"
  }
}
